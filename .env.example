# 复制为 .env 后按需修改（仅 docker compose 会自动读取）
HOST=127.0.0.1
PORT=8787

# 上游 PanSou 兼容接口，逗号分隔可配置多个，按顺序故障转移
PANSOU_ENDPOINTS=https://so.252035.xyz/api/search

UPSTREAM_TIMEOUT_MS=15000
CACHE_TTL_MS=300000
CACHE_MAX=400
RATE_LIMIT_MAX=40
RATE_LIMIT_WINDOW_MS=60000
MAX_RESULTS=400
DEMO_FALLBACK=true
TRUST_PROXY=false

# 首页热门词，逗号分隔，留空则用内置词表
# HOT_WORDS=流浪地球,三体,繁花
